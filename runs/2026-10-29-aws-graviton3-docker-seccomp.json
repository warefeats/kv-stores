{
  "schemaVersion": 1,
  "id": "2026-10-29-aws-graviton3-docker-seccomp",
  "label": "AWS Graviton3 (cloud, Docker default seccomp)",
  "publishedAt": "2026-10-29",
  "environment": {
    "machine": "AWS c7g.metal (engine) + c7g.16xlarge (client)",
    "chip": "AWS Graviton3",
    "cores": "64 physical (engine)",
    "memory": "128 GiB (engine), 128 GiB (client)",
    "os": "Ubuntu 24.04 LTS arm64",
    "arch": "arm64",
    "runtime": "Docker (redis:8.10.3, valkey/valkey:9.1.3, dragonflydb/dragonfly:v2.0.2, kividb/kividb:v1.1.2) under Docker's default seccomp profile, which denies io_uring; memtier_benchmark 2.5.1; RESP2, no TLS"
  },
  "protocol": {
    "warmups": 2,
    "runs": 10,
    "processModel": "Container per engine, network_mode host, Docker's default seccomp profile (io_uring denied): Dragonfly 64 proactor threads on epoll and KiviDB 62 worker threads (its default, cores − 2) on tokio, both their io_uring fallbacks, on 64 physical cores; Redis and Valkey single-threaded I/O (default io-threads 1); 16 GiB maxmemory for all four",
    "cacheState": "Preloaded keyspace, 100% hit ratio on GET workloads; working sets sized below 50% of maxmemory; eviction flags set for parity of intent, never triggered",
    "output": "memtier_benchmark 2.5.1: ops/s, p50/p99/p99.9 latency, client CPU per 10 s pass; memory via INFO MEMORY: baseline-corrected used_memory and used_memory_rss (process RSS) deltas",
    "clientSizing": "memtier: 50 threads × 4 clients = 200 connections"
  },
